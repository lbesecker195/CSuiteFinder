<%= CsuiteFinderWeb.Layout.head(
      title: "For sales teams — CSuiteFinder",
      description: "$#{@seat_usd} per person per month, and every month that seat gets $#{@seat_usd} of lookup credit. Verified work email addresses for the people you need to reach.",
      nav: :teams,
      audience: :sales,
      css: CsuiteFinderWeb.Layout.page_css(:teams)
    ) %>
<header>
  <h1>Reach the decision-maker</br>Not the contact form.</h1>
  <p class="lede">
    Give a name and a company, get a work email address that is checked before you send.
    No API key, no terminal, and no meter running while you work.
  </p>
  <div class="hero-cta">
    <a class="btn btn-primary" href="/account#pricing">Reserve a Seat, now! — $<%= @seat_usd %>/month</a>
    <a class="btn btn-ghost" href="/account">Try it free first</a>
  </div>
  <p class="cta-note">
    <%= @trial_usd %> of credit, no card, good for <%= @trial_months %> month.
    Run your own list through it before deciding anything.
  </p>
</header>


<!-- ── the sample sheet ─────────────────────────────────────────────────────
     Real output, not a mockup: ten Fortune 500 fintech chief executives
     resolved from a name and a domain, then checked against the live mailbox.
     Addresses are masked — CsuiteFinderWeb.SampleSheet says why. -->
<div class="sheet-wrap">
  <div class="sheet">
    <div class="sheet-bar">
      <span class="sheet-namebox">B3</span>
      <span class="sheet-fx">fx</span>
      <span class="sheet-formula"><%= Enum.at(@sheet, 1).email %></span>
    </div>

    <div class="sheet-scroll">
      <table>
        <tbody>
          <tr>
            <td class="corner"></td>
            <td class="col-head">A</td>
            <td class="col-head">B</td>
            <td class="col-head">C</td>
          </tr>
          <tr class="titles">
            <td class="row-head">1</td>
            <td>Name</td>
            <td>Email</td>
            <td>Deliverable</td>
          </tr>
          <%= for {row, index} <- Enum.with_index(@sheet) do %>
          <tr>
            <td class="row-head"><%= index + 2 %></td>
            <td><%= row.name %> <span class="empty-cell">· <%= row.company %></span></td>
            <td class="email<%= if index == 1, do: " active" %>"><%= row.email %></td>
            <td class="st <%= CsuiteFinderWeb.SampleSheet.status_class(row.status) %>"><%= CsuiteFinderWeb.SampleSheet.mark(row.status) %> <%= CsuiteFinderWeb.SampleSheet.label(row.status) %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="sheet-foot">
      <div class="sheet-tabs">
        <span class="sheet-tab on">Prospects</span>
        <span class="sheet-tab">Sheet2</span>
        <span class="sheet-tab">+</span>
      </div>
      <div class="sheet-count">Rows <strong><%= @sheet_rows %></strong> / month</div>
    </div>
  </div>
</div>

<p class="sheet-note">
  Real lookups, run on <%= @sheet_date %>: a name and a company domain in, a work
  address out — and no two of these companies build their addresses the same way.
  Contact details are masked here because these are real people.
  <strong>Deliverable</strong> is the live mailbox check: the two marked
  otherwise are addresses you would have bounced, found before you sent.
</p>

<!-- ── pricing ─────────────────────────────────────────────────────────────
     At the foot of the page on purpose: the nav's Pricing link is a bare
     #pricing fragment, so it scrolls down this page rather than sending a
     salesperson to the developer plan. -->

<div class="plan" id="pricing">
  <div>
    <span class="price">$<%= @seat_usd %></span><span class="per">per person, per month</span>
  </div>
  <p class="gets">
    Every seat gets nearly <strong>400,000 corporate emails</strong> each month.
  </p>
  <ul>
    <%= for item <- @seat_includes do %>
    <li><%= item %></li>
    <% end %>
  </ul>
  <ul class="caveats">
    <%= for item <- @seat_caveats do %>
    <li><%= item %></li>
    <% end %>
  </ul>
  <p style="margin:24px 0 0">
    <a class="btn btn-primary" href="/account#pricing">Reserve a Seat, now!</a>
  </p>
</div>

<%= CsuiteFinderWeb.Layout.footer(:sales) %>

</div>
</body>
</html>
