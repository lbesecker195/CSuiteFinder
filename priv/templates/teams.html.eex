<%= CsuiteFinderWeb.Layout.head(
      title: "For sales teams — CSuiteFinder",
      description: "$#{@seat_usd} per person per month, and every month that seat gets $#{@seat_usd} of lookup credit. Verified work email addresses for the people you need to reach.",
      nav: :teams,
      audience: :sales,
      css: CsuiteFinderWeb.Layout.page_css(:teams)
    ) %>
<header>
  <h1>Reach the decision-maker</br>Not the contact form.</h1>
  <p class="lede">
    Give a name and a company, get a work email address that is checked before you send.
    No API key, no terminal, and no meter running while you work.
  </p>
  <div class="hero-cta">
    <a class="btn btn-primary" href="/account#pricing">Reserve a Seat, now! — $<%= @seat_usd %>/month</a>
    <a class="btn btn-ghost" href="/account#pricing">Try it for $<%= @trial_price %> — <%= @trial_months %> month</a>
  </div>
  <p class="cta-note">
    Not ready for a seat? <strong>$<%= @trial_price %> buys a trial</strong> —
    $<%= @trial_price %> of credit and every lookup a seat gets.
    <strong>The credit expires after <%= @trial_months %> month</strong>, the same way a
    seat's does, because it is a trial of the seat rather than a bundle of credit.
    Run your own list through it before deciding anything.
  </p>
</header>

<%= CsuiteFinderWeb.Layout.sheet(
      rows: @sheet,
      rows_label: @sheet_rows,
      date: @sheet_date,
      visitor: @visitor
    ) %>

<!-- ── pricing ─────────────────────────────────────────────────────────────
     At the foot of the page on purpose: the nav's Pricing link is a bare
     #pricing fragment, so it scrolls down this page rather than sending a
     salesperson to the developer plan. -->

<div class="plan" id="pricing">
  <div>
    <span class="price">$<%= @seat_usd %></span><span class="per">per person, per month</span>
  </div>
  <p class="gets">
    Every seat gets nearly <strong>400,000 corporate emails</strong> each month.
  </p>
  <ul>
    <%= for item <- @seat_includes do %>
    <li><%= item %></li>
    <% end %>
  </ul>
  <ul class="caveats">
    <%= for item <- @seat_caveats do %>
    <li><%= item %></li>
    <% end %>
  </ul>
  <p style="margin:24px 0 0">
    <a class="btn btn-primary" href="/account#pricing">Reserve a Seat, now!</a>
  </p>
</div>

<%= CsuiteFinderWeb.Layout.footer(:sales) %>

</div>
</body>
</html>
