<%= CsuiteFinderWeb.Layout.head(
      title: "Your account — CSuiteFinder",
      robots: "noindex",
      nav: :account,
      css: CsuiteFinderWeb.Layout.page_css(:account),
      wrap_class: "wrap-narrow"
    ) %>

<header>
  <button id="signout" class="ghost" hidden>Sign out</button>
</header>

<div id="message" class="msg"></div>

<!-- ── signed out ──────────────────────────────────────────────────────── -->
<section id="signedout" hidden>
  <h1>Your account</h1>
  <p class="lede">Get an API key, check your balance and buy credit — no headers required.</p>

  <div class="card" data-pricing-anchor>
    <h3 style="margin:0 0 4px;font-size:17px">New here?</h3>
    <p class="muted" style="margin-bottom:16px">
      Registering is instant and gets you a key. A
      <strong>$<%= @trial_price %> trial</strong> buys $<%= @trial_price %> of credit for
      <%= @trial_months %> month. Credit you buy afterwards does not expire.
    </p>
    <div class="row">
      <div>
        <label for="email">Your email</label>
        <input type="email" id="email" placeholder="you@company.com" autocomplete="email"
               value="<%= @prefill_email %>">
      </div>
      <button id="register">Create account</button>
    </div>
    <p class="muted" style="margin:12px 0 0">
      No password needed to start — you set one after your first payment, when
      there is an account worth getting back into.
    </p>
  </div>

  <div class="card">
    <h3 style="margin:0 0 4px;font-size:17px">Already have an account?</h3>
    <p class="muted" style="margin-bottom:16px">Sign in with your email and password.</p>
    <div class="row">
      <div>
        <label for="loginemail">Email</label>
        <input type="email" id="loginemail" placeholder="you@company.com" autocomplete="email"
               value="<%= @prefill_email %>">
      </div>
      <div>
        <label for="loginpassword">Password</label>
        <input type="password" id="loginpassword" placeholder="••••••••••••"
               autocomplete="current-password">
      </div>
      <button id="signin-password">Sign in</button>
    </div>
    <p class="muted" style="margin:14px 0 0">
      <strong>There is no email reset.</strong> We have no mail server, so nobody can send
      you a link. If you are locked out, email <a href="mailto:<%= @contact_email %>">
      <%= @contact_email %></a> and we will set a new one for you.
    </p>
  </div>

</section>

<!-- ── the key, shown once ─────────────────────────────────────────────── -->
<section id="newkey" hidden>
  <h1>Save your API key</h1>
  <div class="note">
    <strong>This is the only time it is shown.</strong> We store only a hash, so we cannot
    recover or resend it — not a policy, just what hashing means. It is saved in this browser
    so you stay signed in here, but that copy disappears if you clear site data or switch
    device. Download it or put it in a password manager now.
  </div>
  <div class="keybox mono" id="newkeyvalue"></div>
  <div class="row">
    <button id="copykey">Copy key</button>
    <button id="downloadkey" class="ghost">Download as file</button>
    <button id="gotkey" class="ghost">I've saved it — continue</button>
  </div>
</section>

<!-- ── signed in ───────────────────────────────────────────────────────── -->
<section id="signedin" hidden>
  <h1>Your account</h1>
  <p class="lede" id="whoami"></p>

  <!-- Shown only to an account that has paid and has no password yet — the
       checkout deliberately does not ask for one, so this is where it gets
       asked. Placed at the top because until it is done, the only way back into
       this account is a key living in one browser's storage. -->
  <div class="card secure-card" id="securecard" hidden>
    <h3 class="card-title" id="securetitle">Set a password before you go</h3>
    <p class="muted" id="securewhy" style="margin-top:0">
      Your account lives in this browser right now. A password is how you get
      back in from anywhere else — and there is no reset email, so this is worth
      the ten seconds.
    </p>
    <div class="row">
      <div>
        <label for="firstpassword">Password</label>
        <input type="password" id="firstpassword"
               placeholder="at least <%= @min_password %> characters"
               autocomplete="new-password">
      </div>
      <button id="savefirstpassword">Save password</button>
    </div>
  </div>

  <div class="card">
    <label>Balance</label>
    <div class="balance">
      <span class="big" id="balance">—</span>
      <span class="unit" id="balanceusd"></span>
    </div>
    <p class="muted" id="findsleft" style="margin:12px 0 0"></p>
    <p class="muted" id="balancesplit" style="margin:8px 0 0" hidden></p>
  </div>

  <!-- ── pricing ───────────────────────────────────────────────────────────
       One anchor, two purchase paths. The nav's Pricing link is a bare
       #pricing fragment on every page, and which of these two a visitor sees
       is decided by their audience — a seat holder is never shown a per-answer
       price list, and a developer is never shown a seat they cannot use. -->
  <div data-pricing-anchor>

  <div data-aud="sales">
  <h2 id="trial">Try it — $<%= @trial_price %>, once</h2>
  <p class="muted" style="margin-top:-6px">
    $<%= @trial_price %> buys $<%= @trial_price %> of credit for one month — the same
    lookups a seat gets, on the same terms, so what you are trying is the thing you
    would buy. One per account.
  </p>

  <div class="card" id="trialcard">
    <div class="row">
      <button id="buytrial">Start the trial — $<%= @trial_price %></button>
      <p class="muted" style="margin:0;flex:1;min-width:210px">
        You'll be sent to PayPal to approve, then straight back here.
      </p>
    </div>
  </div>

  <h2 id="seats">Seats — $<%= @seat_usd_label %> a month</h2>
  <p class="muted" style="margin-top:-6px">
    A seat is billed $<%= @seat_usd_label %> a month through PayPal and puts
    $<%= @seat_usd_label %> of credit in this account every month. Unused credit
    <strong>does not roll over</strong> — each payment starts you at
    $<%= @seat_usd_label %> again. Credit you buy outright is separate and never expires.
  </p>

  <div class="card" id="seatcard">
    <div id="seatnone">
      <div class="row">
        <div>
          <label for="seatcount">How many people?</label>
          <input type="text" id="seatcount" value="1" inputmode="numeric">
        </div>
        <button id="subscribe">Start a subscription</button>
      </div>
      <p class="muted" id="seatquote" style="margin:12px 0 0"></p>
    </div>

    <div id="seatactive" hidden>
      <div class="balance">
        <span class="big" id="seatseats">—</span>
        <span class="unit" id="seatstate"></span>
      </div>
      <p class="muted" id="seatperiod" style="margin:12px 0 0"></p>
      <div class="row" style="margin-top:16px">
        <button id="cancelseat" class="ghost">Cancel subscription</button>
      </div>
    </div>
  </div>

  </div>

  <div data-aud="developer" hidden>
  <h2>Buy credit</h2>
  <p class="muted" style="margin-top:-6px">
    Credit never expires and a dollar buys a dollar of it. Purchases start at
    $<%= @minimum_usd_label %>. You'll be sent to PayPal to approve, then straight back here.
  </p>
  <div class="bundles" id="bundles">
    <%= for b <- @bundles do %>
    <button class="bundle" data-usd="<%= b.usd %>">
      <span class="price">$<%= b.usd_label %></span>
      <span class="credit">$<%= b.usd_label %> of credit</span>
      <span class="finds"><%= b.emails_label %> work email addresses</span>
    </button>
    <% end %>
  </div>
  </div>

  </div>

  <h2>Usage — last 30 days</h2>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead><tr><th>Endpoint</th><th class="num">Calls</th><th class="num">Found</th><th class="num" data-aud="developer" hidden>Spend</th></tr></thead>
        <tbody id="usage"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>

  <h2>Password</h2>
  <div class="card">
    <p class="muted" style="margin-top:0">
      Set one and you can sign in with your email instead of keeping a key on your
      clipboard. At least <%= @min_password %> characters; length is the only rule.
      <strong>There is no email reset</strong> — if you forget it, sign in with your API
      key and set a new one.
    </p>
    <div class="row">
      <div>
        <label for="setpassword">New password</label>
        <input type="password" id="setpassword" placeholder="••••••••••••"
               autocomplete="new-password">
      </div>
      <button id="savepassword" class="ghost">Save password</button>
    </div>
  </div>

  <h2>Your keys</h2>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead><tr><th>Key</th><th>Label</th><th>Last used</th><th></th></tr></thead>
        <tbody id="keys"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
    <div class="row" style="margin-top:16px">
      <button id="newkeybtn" class="ghost">Create another key</button>
    </div>
    <p class="muted" style="margin:14px 0 0">
      <strong>Create a spare and keep it somewhere safe.</strong> A key cannot be recovered if
      it is lost — but a second one lets you revoke the first and carry on, and your
      balance is never affected either way. The key you are signed in with lives in this
      browser only, never goes anywhere but this API, and is cleared when you sign out. Send it
      as <code>Authorization: Bearer &lt;key&gt;</code> from your own code.
    </p>
  </div>
</section>

<%= CsuiteFinderWeb.Layout.footer() %>

</div>

<script>
(function () {
  "use strict";
  var API = "/csuitefinder";

  // Set by the checkout's return_url. Read once, before handleReturn() cleans
  // the query string off the address bar.
  var justBought = new URLSearchParams(window.location.search).get("bought");
  var STORE = "csf_api_key";
  var key = null;

  var $ = function (id) { return document.getElementById(id); };

  function show(which) {
    ["signedout", "newkey", "signedin"].forEach(function (id) {
      $(id).hidden = (id !== which);
    });
    $("signout").hidden = (which !== "signedin");

    // Every page's nav points at a bare #pricing, and on this page the thing it
    // should land on depends on whether anyone is signed in. An id inside a
    // hidden section is an id the browser will not scroll to, so it moves to
    // whichever half is showing rather than sitting on one of them.
    document.querySelectorAll("[data-pricing-anchor]").forEach(function (el) {
      var visible = !el.closest("section[hidden]");
      if (visible) { el.id = "pricing"; } else if (el.id === "pricing") { el.removeAttribute("id"); }
    });

    // Sign-in and sign-out happen without a page load, so the header label
    // has to be updated here too or it goes stale mid-session.
    var navLink = document.getElementById("nav-account");
    if (navLink) navLink.textContent = key ? "Dashboard" : "Register / Log in";
  }

  function say(text, kind) {
    var el = $("message");
    el.textContent = text;
    el.className = "msg " + (kind || "info");
    if (!text) el.className = "msg";
  }

  // localStorage throws in some privacy modes; a broken store must not break the page.
  function load() { try { return localStorage.getItem(STORE); } catch (e) { return null; } }
  function save(v) { try { localStorage.setItem(STORE, v); } catch (e) {} }
  function drop()  { try { localStorage.removeItem(STORE); } catch (e) {} }

  function api(path, opts) {
    opts = opts || {};
    var headers = { "content-type": "application/json" };
    if (key) headers["authorization"] = "Bearer " + key;
    return fetch(API + path, {
      method: opts.method || "GET",
      headers: headers,
      body: opts.body ? JSON.stringify(opts.body) : undefined
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (body) {
        return { ok: r.ok, status: r.status, body: body };
      });
    });
  }

  function commas(n) { return (n || 0).toLocaleString("en-US"); }

  function renderBalance(b) {
    setAudience(b.audience);
    var usd = b.balance_usd || 0;
    $("balance").textContent = "$" + usd.toFixed(2);
    $("balanceusd").textContent = "of credit";
    renderSplit(b);
    renderTrial(b);
    renderSecure(b);
    var perEmail = (b.prices_usd && b.prices_usd["email.find"]) || 0.0025;
    $("findsleft").textContent = usd > 0
      ? commas(Math.floor(usd / perEmail)) + " more work email addresses. " +
        "Deliverability checks, identity lookups and company data are included."
      : "Out of credit — buy more below to carry on.";
    $("whoami").textContent = b.email || "";
  }

  // Two pools with different lifetimes. Shown separately whenever both are in
  // play, because "you have $1,004" is a misleading number when $999 of it
  // disappears at the end of the month.
  function renderSplit(b) {
    var el = $("balancesplit");
    var granted = b.granted_usd || 0;
    var purchased = b.purchased_usd || 0;

    if (granted <= 0) { el.hidden = true; return; }

    var when = b.granted_expires_at
      ? " until " + new Date(b.granted_expires_at).toLocaleDateString()
      : "";
    el.textContent =
      "$" + granted.toFixed(2) + " of that is monthly credit" + when +
      " and does not roll over. $" + purchased.toFixed(2) + " is credit you bought, which never expires.";
    el.hidden = false;
  }

  // Which half of the business this visitor is in. Sales until something says
  // otherwise — the account's own answer, once they sign in, is the last word.
  var audience = window.csfAudience ? window.csfAudience() : "sales";

  function setAudience(value) {
    if (value !== "sales" && value !== "developer") return;
    audience = value;
    if (window.csfSetAudience) window.csfSetAudience(value);
  }

  var SEAT_USD = <%= @seat_usd %>;

  function quoteSeats() {
    var n = parseInt($("seatcount").value, 10);
    $("seatquote").textContent = (n > 0)
      ? "$" + commas(n * SEAT_USD) + " a month, and $" + commas(n * SEAT_USD) +
        " of credit added each month."
      : "Enter how many people need a seat.";
  }

  // Asked for only once there is an account worth keeping: someone who has paid
  // has a reason to come back, and until they have, a password field is a
  // question that costs signups and protects nothing.
  function renderSecure(b) {
    var card = $("securecard");
    if (!card) return;

    // `justBought` matters on its own. A seat is charged by PayPal's webhook
    // rather than at the moment of approval, so someone arriving straight back
    // from a $999 subscription still reads as a zero balance here — and that is
    // exactly the person who most needs a way back into the account.
    var paid = justBought || b.trial_taken === true || (b.balance_usd || 0) > 0 ||
               (b.purchased_usd || 0) > 0 || (b.granted_usd || 0) > 0;

    card.hidden = b.has_password === true || !paid;

    if (!card.hidden && justBought) {
      $("securetitle").textContent = "One last thing — set a password";
      $("securewhy").textContent =
        "Payment received. Your account currently lives in this browser only, and " +
        "there is no reset email, so set a password now and you can sign in from " +
        "anywhere.";
    }
  }

  function renderTrial(b) {
    // Offered only until it has been taken: what settles it is whether a trial
    // was ever granted at all, not whether its credit is still unspent.
    var card = $("trialcard");
    if (card) card.hidden = b.trial_taken === true;
  }

  function renderSeats(s) {
    var live = s && ["active", "approved", "suspended"].indexOf(s.status) !== -1;
    $("seatnone").hidden = live;
    $("seatactive").hidden = !live;
    if (!live) { quoteSeats(); return; }

    $("seatseats").textContent = s.seats + (s.seats === 1 ? " seat" : " seats");
    $("seatstate").textContent = s.status === "active" ? "active" : s.status;
    $("seatperiod").textContent =
      "$" + commas(s.credit_usd_per_month) + " of credit a month" +
      (s.current_period_end
        ? ", next renewal " + new Date(s.current_period_end).toLocaleDateString()
        : "") + ". Unused credit does not roll over.";
  }

  function loadSeats() {
    return api("/billing/subscription").then(function (res) {
      if (res.ok) renderSeats(res.body.subscription);
    });
  }

  function renderUsage(u) {
    var rows = (u && u.by_endpoint) || [];
    var body = $("usage");
    if (!rows.length) {
      body.innerHTML = '<tr><td colspan="4" class="muted">No calls yet.</td></tr>';
      return;
    }
    // A per-endpoint charge divided by the answers it bought is the unit price,
    // so the column only exists for the audience that is sold on unit prices.
    // The server withholds the figure as well — this is presentation, not the
    // guard.
    var spend = audience === "developer";
    body.innerHTML = rows.map(function (r) {
      return "<tr><td><code>" + r.endpoint + "</code></td>" +
             '<td class="num">' + commas(r.calls) + "</td>" +
             '<td class="num">' + commas(r.found) + "</td>" +
             (spend ? '<td class="num">$' + ((r.charged_micro || 0) / 1e6).toFixed(4) + "</td>" : "") +
             "</tr>";
    }).join("");
  }

  function refresh() {
    return api("/billing/balance").then(function (res) {
      if (res.status === 401) { signOut("That key is not valid. Sign in again."); return; }
      if (!res.ok) { say("Could not load your balance. Try again shortly.", "err"); return; }
      show("signedin");
      renderBalance(res.body);
      api("/billing/usage?days=30").then(function (u) { if (u.ok) renderUsage(u.body); });
      loadSeats();
      loadKeys();
    });
  }

  function signOut(msg) {
    // Tell the server first, so a session token stops working everywhere rather
    // than only in this browser. A key is untouched either way.
    if (key && key.indexOf("csf_sess_") === 0) { api("/logout", { method: "POST", body: {} }); }
    key = null; drop();
    show("signedout");
    say(msg || "", msg ? "info" : null);
  }

  // ---- register -----------------------------------------------------------
  $("register").addEventListener("click", function () {
    var email = $("email").value.trim();
    if (!email) { say("Enter your email first.", "err"); return; }
    var btn = this; btn.disabled = true; say("Creating your account…", "info");

    // No password is asked for here. One is asked for after a payment lands,
    // which is the first moment it is worth anybody's time — see renderSecure.
    var payload = { email: email, audience: audience };

    api("/register", { method: "POST", body: payload }).then(function (res) {
      btn.disabled = false;
      if (!res.ok) {
        var detail = res.body && res.body.details && res.body.details.email;
        // "has already been taken" is the only failure a person can act on, and
        // the action is signing in rather than picking another address. The old
        // wording repeated the changeset at them and left them stuck.
        if (detail && detail[0] && detail[0].indexOf("already") >= 0) {
          say("That email already has an account — sign in just below.", "err");
          var box = $("loginemail");
          if (box) { box.value = email; box.focus(); }
          return;
        }
        // Anything else is ours, not theirs. Say the status rather than a
        // guess, so a report of it is worth something.
        say(detail
          ? "That email " + detail[0] + "."
          : "Sign-up failed (" + (res.status || "no response") + "). Nothing was charged — " +
            "try again, or email us and we will sort it out.", "err");
        return;
      }
      key = res.body.api_key; save(key);
      $("newkeyvalue").textContent = key;
      show("newkey");
      // No credit comes with an account any more, so the next step is the
      // thing to say rather than a balance of zero.
      say("Account created. Buy the trial below to start looking things up.", "ok");
    });
  });

  // ---- sign in with a password --------------------------------------------
  $("signin-password").addEventListener("click", function () {
    var email = $("loginemail").value.trim();
    var password = $("loginpassword").value;
    if (!email || !password) { say("Enter your email and password.", "err"); return; }

    var btn = this;
    btn.disabled = true;
    say("Signing in…", "info");

    // No key on this call — it is the one request that authenticates itself.
    fetch(API + "/login", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ email: email, password: password })
    }).then(function (r) {
      return r.json().catch(function () { return {}; })
        .then(function (body) { return { ok: r.ok, body: body }; });
    }).then(function (res) {
      btn.disabled = false;
      $("loginpassword").value = "";

      if (!res.ok) {
        say((res.body && res.body.message) || "Could not sign you in.", "err");
        return;
      }
      // A session token is kept exactly where a pasted key was: same storage,
      // same header, and it expires on its own.
      key = res.body.token;
      save(key);
      say("");
      refresh();
    });
  });

  $("savefirstpassword").addEventListener("click", function () {
    var value = $("firstpassword").value;
    if (!value) { say("Choose a password first.", "err"); return; }

    var btn = this;
    btn.disabled = true;

    api("/password", { method: "POST", body: { password: value } }).then(function (res) {
      btn.disabled = false;
      $("firstpassword").value = "";
      if (res.ok) {
        $("securecard").hidden = true;
        say("Password saved. You can sign in with your email from any browser now.", "ok");
        return;
      }
      say((res.body && res.body.message) || "Could not save that password.", "err");
    });
  });

  $("savepassword").addEventListener("click", function () {
    var value = $("setpassword").value;
    if (!value) { say("Enter a password first.", "err"); return; }

    var btn = this;
    btn.disabled = true;

    api("/password", { method: "POST", body: { password: value } }).then(function (res) {
      btn.disabled = false;
      $("setpassword").value = "";
      say((res.body && res.body.message) || "Could not save that password.",
          res.ok ? "ok" : "err");
    });
  });

  // ---- sign in ------------------------------------------------------------
  $("copykey").addEventListener("click", function () {
    var btn = this;
    navigator.clipboard.writeText($("newkeyvalue").textContent).then(function () {
      btn.textContent = "Copied";
      setTimeout(function () { btn.textContent = "Copy key"; }, 1600);
    }, function () { say("Copy failed — select the key and copy it manually.", "err"); });
  });

  $("downloadkey").addEventListener("click", function () {
    var text = "CSuiteFinder API key\n" + $("newkeyvalue").textContent + "\n\n" +
               "Send it as: Authorization: Bearer <key>\n";
    var url = URL.createObjectURL(new Blob([text], { type: "text/plain" }));
    var a = document.createElement("a");
    a.href = url; a.download = "csuitefinder-api-key.txt";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  $("gotkey").addEventListener("click", function () { say(""); refresh(); });
  $("signout").addEventListener("click", function () { signOut("Signed out."); });

  // ---- keys ---------------------------------------------------------------
  function loadKeys() {
    api("/keys").then(function (res) {
      var body = $("keys");
      if (!res.ok) { body.innerHTML = '<tr><td colspan="4" class="muted">Could not load keys.</td></tr>'; return; }
      body.innerHTML = (res.body.keys || []).map(function (k) {
        var used = k.last_used_at ? new Date(k.last_used_at).toLocaleDateString() : "never";
        var state = k.revoked
          ? '<span class="muted">revoked</span>'
          : (k.current
              ? '<span class="muted">in use here</span>'
              : '<button class="ghost revoke" data-id="' + k.id + '">Revoke</button>');
        return "<tr><td><code>" + k.prefix + "…</code></td>" +
               "<td>" + (k.label || "") + "</td>" +
               '<td class="muted">' + used + "</td>" +
               '<td class="num">' + state + "</td></tr>";
      }).join("") || '<tr><td colspan="4" class="muted">No keys.</td></tr>';

      body.querySelectorAll(".revoke").forEach(function (b) {
        b.addEventListener("click", function () {
          if (!window.confirm("Revoke this key? Anything using it stops working immediately.")) return;
          b.disabled = true;
          api("/keys/" + b.getAttribute("data-id"), { method: "DELETE" }).then(function (r) {
            say(r.ok ? "Key revoked." : "Could not revoke that key.", r.ok ? "ok" : "err");
            loadKeys();
          });
        });
      });
    });
  }

  $("newkeybtn").addEventListener("click", function () {
    var btn = this; btn.disabled = true;
    api("/keys", { method: "POST", body: {} }).then(function (res) {
      btn.disabled = false;
      if (!res.ok) { say("Could not create a key.", "err"); return; }
      // Show it on the same one-time screen the first key uses, so the "save
      // this now" warning is never skipped for a second key.
      $("newkeyvalue").textContent = res.body.api_key;
      show("newkey");
      say("New key created. The one you are signed in with still works.", "ok");
    });
  });

  // ---- trial --------------------------------------------------------------
  $("buytrial").addEventListener("click", function () {
    var btn = this;
    var back = window.location.origin + window.location.pathname;
    btn.disabled = true;
    say("Setting up your trial…", "info");

    api("/billing/trial", { method: "POST", body: {
      return_url: back + "#pricing", cancel_url: back + "?cancelled=1#pricing"
    }}).then(function (res) {
      btn.disabled = false;
      if (res.ok && res.body.approve_url) {
        say("Redirecting you to PayPal…", "info");
        window.location.href = res.body.approve_url;
        return;
      }
      if (res.body && res.body.error === "trial_already_taken") {
        say(res.body.message, "err");
        $("trialcard").hidden = true;
      } else if (res.body && res.body.error === "paypal_not_configured") {
        say("Payments are not switched on yet. Please try again later.", "err");
      } else {
        say("Could not start that trial. Nothing was charged.", "err");
      }
    });
  });

  // ---- seats --------------------------------------------------------------
  $("seatcount").addEventListener("input", quoteSeats);

  $("subscribe").addEventListener("click", function () {
    var btn = this;
    var n = parseInt($("seatcount").value, 10);
    if (!(n > 0)) { say("Enter how many people need a seat.", "err"); return; }

    var back = window.location.origin + window.location.pathname;
    btn.disabled = true;
    say("Setting up your subscription…", "info");

    api("/billing/subscribe", { method: "POST", body: {
      seats: n, return_url: back + "#seats", cancel_url: back + "?cancelled=1#seats"
    }}).then(function (res) {
      btn.disabled = false;
      if (res.ok && res.body.approve_url) {
        say("Redirecting you to PayPal…", "info");
        window.location.href = res.body.approve_url;
        return;
      }
      if (res.body && res.body.error === "paypal_not_configured") {
        say("Subscriptions are not switched on yet. Please try again later.", "err");
      } else if (res.body && res.body.error === "invalid_seats") {
        say(res.body.message, "err");
      } else {
        say("Could not start that subscription. Nothing was charged.", "err");
      }
    });
  });

  $("cancelseat").addEventListener("click", function () {
    if (!window.confirm(
      "Cancel the subscription? The month you have already paid for runs to its end, " +
      "and credit you bought outright is not affected.")) return;
    var btn = this; btn.disabled = true;
    api("/billing/subscription/cancel", { method: "POST", body: {} }).then(function (res) {
      btn.disabled = false;
      say(res.ok ? "Subscription cancelled." : "Could not cancel that subscription.",
          res.ok ? "ok" : "err");
      refresh();
    });
  });

  // ---- buy ----------------------------------------------------------------
  document.querySelectorAll(".bundle").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var usd = Number(btn.getAttribute("data-usd"));
      var back = window.location.origin + window.location.pathname;
      btn.disabled = true;
      say("Setting up your payment…", "info");

      api("/billing/topup", { method: "POST", body: {
        amount_usd: usd, return_url: back, cancel_url: back + "?cancelled=1"
      }}).then(function (res) {
        btn.disabled = false;
        if (res.ok && res.body.approve_url) {
          say("Redirecting you to PayPal…", "info");
          window.location.href = res.body.approve_url;
          return;
        }
        if (res.body && res.body.error === "paypal_not_configured") {
          say("Payments are not switched on yet. Please try again later.", "err");
        } else if (res.body && res.body.error === "below_minimum_purchase") {
          say("Purchases start at $" + commas(res.body.minimum_usd) + ".", "err");
        } else {
          say("Could not start that payment. Nothing was charged.", "err");
        }
      });
    });
  });

  // ---- returning from PayPal ---------------------------------------------
  // PayPal sends the order id back as ?token=… (its name, not ours) on the
  // return URL. Capture it, then clean the query so a refresh cannot re-post.
  function handleReturn() {
    var params = new URLSearchParams(window.location.search);
    var order = params.get("token");
    var subscription = params.get("subscription_id");
    var cancelled = params.get("cancelled");

    function clean() {
      window.history.replaceState({}, "", window.location.pathname);
    }

    if (cancelled) { clean(); say("Payment cancelled — nothing was charged.", "info"); return false; }

    // A subscription approval comes back with subscription_id. There is nothing
    // to capture: PayPal charges it and tells us over the webhook, which is what
    // grants the month. So we only confirm and re-read.
    if (subscription) {
      clean();
      say("Subscription approved. Your monthly credit appears as soon as PayPal " +
          "confirms the first payment.", "ok");
      refresh();
      return true;
    }

    if (!order) return false;

    say("Confirming your payment…", "info");
    api("/billing/capture", { method: "POST", body: { paypal_order_id: order } })
      .then(function (res) {
        clean();
        if (res.ok && res.body.status === "credited") {
          var added = "Payment complete — $" + (res.body.credited_usd || 0).toFixed(2) +
                      " of credit added.";
          if (res.body.kind === "seat_trial") {
            // The one thing a trial buyer must not discover later.
            added += " It expires in " + (res.body.expires_in_months || 1) +
                     " month — spend it before then.";
          }
          say(added, "ok");
        } else {
          say("We could not confirm that payment yet. If you approved it, your credit will " +
              "appear shortly — PayPal notifies us separately.", "err");
        }
        refresh();
      });
    return true;
  }

  // ---- boot ---------------------------------------------------------------
  // The server fills this field when the address came in on this page's own
  // URL. When the visitor picked it up on an earlier page, it is here instead.
  if (!$("email").value && window.csfPrefillEmail) {
    $("email").value = window.csfPrefillEmail();
  }

  key = load();
  var returning = handleReturn();
  if (key) { if (!returning) refresh(); }
  else { show("signedout"); }
})();
</script>
</body>
</html>
