<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= CsuiteFinderWeb.Analytics.tag() %>
<meta name="robots" content="noindex">
<title>Your account — CSuiteFinder</title>
<style>
  :root {
    --bg:#fbfaf8; --surface:#fff; --border:#e4e0d9; --text:#1c1a17; --muted:#6b6560;
    --faint:#98918a; --accent:#b8541f; --accent-soft:#fdf1e8; --code-bg:#f5f2ee;
    --good:#2f6b45; --good-soft:#eaf3ed; --bad:#a32b1c; --bad-soft:#fbecea;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#161513; --surface:#1e1d1a; --border:#33302b; --text:#ece8e2; --muted:#a09990;
      --faint:#756e66; --accent:#e8834a; --accent-soft:#2a1d14; --code-bg:#131210;
      --good:#7bbd93; --good-soft:#17251c; --bad:#e8796a; --bad-soft:#2a1613;
    }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);
       font:16px/1.6 ui-sans-serif,-apple-system,"Segoe UI",Inter,system-ui,sans-serif;
       -webkit-font-smoothing:antialiased}
  .wrap{max-width:760px;margin:0 auto;padding:0 24px 80px}
  header{display:flex;justify-content:space-between;align-items:baseline;gap:16px;
         padding:34px 0 26px;flex-wrap:wrap}
  .logo{font-weight:700;font-size:15px;text-transform:uppercase;letter-spacing:.04em;
        color:var(--accent);text-decoration:none}
  h1{font-size:clamp(26px,4.5vw,34px);letter-spacing:-.025em;margin:0 0 10px;font-weight:700}
  h2{font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);
     font-weight:600;margin:38px 0 14px}
  p{margin:0 0 16px}
  .lede{color:var(--muted);margin:0 0 26px}
  a{color:var(--accent)}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:12px;
        padding:22px;margin-bottom:14px}
  label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px;font-weight:600}
  input[type=email],input[type=text]{
    width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:8px;
    background:var(--bg);color:var(--text);font:inherit;font-size:15px}
  input:focus{outline:2px solid var(--accent);outline-offset:1px}
  button{font:inherit;font-weight:600;border-radius:8px;border:1px solid transparent;
         padding:11px 18px;cursor:pointer;background:var(--accent);color:#fff}
  button:hover{filter:brightness(1.07)}
  button:disabled{opacity:.55;cursor:not-allowed;filter:none}
  button.ghost{background:transparent;border-color:var(--border);color:var(--muted)}
  .row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
  .row > div{flex:1;min-width:210px}
  .balance{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
  .balance .big{font-size:42px;font-weight:700;letter-spacing:-.03em;line-height:1}
  .balance .unit{color:var(--muted);font-size:15px}
  .bundles{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
  .bundle{background:var(--surface);border:1px solid var(--border);border-radius:12px;
          padding:18px;text-align:left;color:var(--text);cursor:pointer;transition:.12s}
  .bundle:hover{border-color:var(--accent);transform:translateY(-1px)}
  .bundle .price{font-size:25px;font-weight:700;letter-spacing:-.02em;display:block}
  .bundle .credit{font-size:13px;color:var(--muted);margin-top:3px;display:block}
  .bundle .finds{font-size:12px;color:var(--faint);margin-top:7px;display:block}
  code,.mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-size:13px}
  .keybox{background:var(--code-bg);border:1px solid var(--border);border-radius:8px;
          padding:13px;word-break:break-all;margin:12px 0}
  .note{border-left:3px solid var(--accent);background:var(--accent-soft);padding:13px 17px;
        border-radius:0 8px 8px 0;font-size:14.5px;margin:0 0 16px}
  .msg{padding:13px 17px;border-radius:8px;font-size:14.5px;margin-bottom:16px;display:none}
  .msg.ok{background:var(--good-soft);color:var(--good);display:block}
  .msg.err{background:var(--bad-soft);color:var(--bad);display:block}
  .msg.info{background:var(--accent-soft);color:var(--accent);display:block}
  table{border-collapse:collapse;width:100%;font-size:14px}
  th,td{text-align:left;padding:9px 11px;border-bottom:1px solid var(--border)}
  th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
  .num{text-align:right;font-variant-numeric:tabular-nums}
  .table-scroll{overflow-x:auto}
  .muted{color:var(--muted);font-size:13.5px}
  footer{margin-top:44px;padding-top:22px;border-top:1px solid var(--border);
         color:var(--faint);font-size:13px}
  [hidden]{display:none !important}
<%= CsuiteFinderWeb.Nav.css() %></style>
</head>
<body>
<div class="wrap">

<%= CsuiteFinderWeb.Nav.render(:account) %>

<header>
  <button id="signout" class="ghost" hidden>Sign out</button>
</header>

<div id="message" class="msg"></div>

<!-- ── signed out ──────────────────────────────────────────────────────── -->
<section id="signedout" hidden>
  <h1>Your account</h1>
  <p class="lede">Get an API key, check your balance and buy credit — no headers required.</p>

  <div class="card">
    <h3 style="margin:0 0 4px;font-size:17px">New here?</h3>
    <p class="muted" style="margin-bottom:16px">
      Registering is instant and gives you <strong>$<%= @trial_usd %> of free credit</strong>
      — real lookups, no card.
    </p>
    <div class="row">
      <div>
        <label for="email">Your email</label>
        <input type="email" id="email" placeholder="you@company.com" autocomplete="email">
      </div>
      <button id="register">Create account</button>
    </div>
  </div>

  <div class="card">
    <h3 style="margin:0 0 4px;font-size:17px">Already have a key?</h3>
    <p class="muted" style="margin-bottom:16px">Paste it to see your balance and buy credit.</p>
    <div class="row">
      <div>
        <label for="key">API key</label>
        <input type="text" id="key" placeholder="csf_live_…" spellcheck="false" autocomplete="off">
      </div>
      <button id="signin">Continue</button>
    </div>
  </div>

</section>

<!-- ── the key, shown once ─────────────────────────────────────────────── -->
<section id="newkey" hidden>
  <h1>Save your API key</h1>
  <div class="note">
    <strong>This is the only time it is shown.</strong> We store only a hash, so we cannot
    recover or resend it — not a policy, just what hashing means. It is saved in this browser
    so you stay signed in here, but that copy disappears if you clear site data or switch
    device. Download it or put it in a password manager now.
  </div>
  <div class="keybox mono" id="newkeyvalue"></div>
  <div class="row">
    <button id="copykey">Copy key</button>
    <button id="downloadkey" class="ghost">Download as file</button>
    <button id="gotkey" class="ghost">I've saved it — continue</button>
  </div>
</section>

<!-- ── signed in ───────────────────────────────────────────────────────── -->
<section id="signedin" hidden>
  <h1>Your account</h1>
  <p class="lede" id="whoami"></p>

  <div class="card">
    <label>Balance</label>
    <div class="balance">
      <span class="big" id="balance">—</span>
      <span class="unit" id="balanceusd"></span>
    </div>
    <p class="muted" id="findsleft" style="margin:12px 0 0"></p>
  </div>

  <h2>Buy credit</h2>
  <p class="muted" style="margin-top:-6px">
    Credit never expires and a dollar buys a dollar of it. Purchases start at
    $<%= @minimum_usd_label %>. You'll be sent to PayPal to approve, then straight back here.
  </p>
  <div class="bundles" id="bundles">
    <%= for b <- @bundles do %>
    <button class="bundle" data-usd="<%= b.usd %>">
      <span class="price">$<%= b.usd_label %></span>
      <span class="credit">$<%= b.usd_label %> of credit</span>
      <span class="finds"><%= b.emails_label %> emails, or <%= b.phones_label %> phone numbers</span>
    </button>
    <% end %>
  </div>

  <h2>Usage — last 30 days</h2>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead><tr><th>Endpoint</th><th class="num">Calls</th><th class="num">Found</th><th class="num">Spend</th></tr></thead>
        <tbody id="usage"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>

  <h2>Your keys</h2>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead><tr><th>Key</th><th>Label</th><th>Last used</th><th></th></tr></thead>
        <tbody id="keys"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
    <div class="row" style="margin-top:16px">
      <button id="newkeybtn" class="ghost">Create another key</button>
    </div>
    <p class="muted" style="margin:14px 0 0">
      <strong>Create a spare and keep it somewhere safe.</strong> A key cannot be recovered if
      it is lost — but a second one lets you revoke the first and carry on, and your
      balance is never affected either way. The key you are signed in with lives in this
      browser only, never goes anywhere but this API, and is cleared when you sign out. Send it
      as <code>Authorization: Bearer &lt;key&gt;</code> from your own code.
    </p>
  </div>
</section>

<footer>
  <a href="/">Home</a> · <a href="/start">Get started</a> · <a href="/llms.txt">llms.txt</a> ·
  <a href="/csuitefinder/pricing">pricing</a> · <a href="/csuitefinder/health">status</a>
</footer>

</div>

<script>
(function () {
  "use strict";
  var API = "/csuitefinder";
  var STORE = "csf_api_key";
  var key = null;

  var $ = function (id) { return document.getElementById(id); };

  function show(which) {
    ["signedout", "newkey", "signedin"].forEach(function (id) {
      $(id).hidden = (id !== which);
    });
    $("signout").hidden = (which !== "signedin");

    // Sign-in and sign-out happen without a page load, so the header label
    // has to be updated here too or it goes stale mid-session.
    var navLink = document.getElementById("nav-account");
    if (navLink) navLink.textContent = key ? "Dashboard" : "Register / Log in";
  }

  function say(text, kind) {
    var el = $("message");
    el.textContent = text;
    el.className = "msg " + (kind || "info");
    if (!text) el.className = "msg";
  }

  // localStorage throws in some privacy modes; a broken store must not break the page.
  function load() { try { return localStorage.getItem(STORE); } catch (e) { return null; } }
  function save(v) { try { localStorage.setItem(STORE, v); } catch (e) {} }
  function drop()  { try { localStorage.removeItem(STORE); } catch (e) {} }

  function api(path, opts) {
    opts = opts || {};
    var headers = { "content-type": "application/json" };
    if (key) headers["authorization"] = "Bearer " + key;
    return fetch(API + path, {
      method: opts.method || "GET",
      headers: headers,
      body: opts.body ? JSON.stringify(opts.body) : undefined
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (body) {
        return { ok: r.ok, status: r.status, body: body };
      });
    });
  }

  function commas(n) { return (n || 0).toLocaleString("en-US"); }

  function renderBalance(b) {
    var usd = b.balance_usd || 0;
    $("balance").textContent = "$" + usd.toFixed(2);
    $("balanceusd").textContent = "of credit";
    var perEmail = (b.prices_usd && b.prices_usd["email.find"]) || 0.0025;
    var perPhone = (b.prices_usd && b.prices_usd["phone.find"]) || 0.025;
    $("findsleft").textContent = usd > 0
      ? commas(Math.floor(usd / perEmail)) + " more email addresses, or " +
        commas(Math.floor(usd / perPhone)) + " phone numbers. Everything else is included."
      : "Out of credit — buy more below to carry on.";
    $("whoami").textContent = b.email || "";
  }

  function renderUsage(u) {
    var rows = (u && u.by_endpoint) || [];
    var body = $("usage");
    if (!rows.length) {
      body.innerHTML = '<tr><td colspan="4" class="muted">No calls yet.</td></tr>';
      return;
    }
    body.innerHTML = rows.map(function (r) {
      return "<tr><td><code>" + r.endpoint + "</code></td>" +
             '<td class="num">' + commas(r.calls) + "</td>" +
             '<td class="num">' + commas(r.found) + "</td>" +
             '<td class="num">$' + ((r.charged_micro || 0) / 1e6).toFixed(4) + "</td></tr>";
    }).join("");
  }

  function refresh() {
    return api("/billing/balance").then(function (res) {
      if (res.status === 401) { signOut("That key is not valid. Sign in again."); return; }
      if (!res.ok) { say("Could not load your balance. Try again shortly.", "err"); return; }
      show("signedin");
      renderBalance(res.body);
      api("/billing/usage?days=30").then(function (u) { if (u.ok) renderUsage(u.body); });
      loadKeys();
    });
  }

  function signOut(msg) {
    key = null; drop();
    show("signedout");
    say(msg || "", msg ? "info" : null);
  }

  // ---- register -----------------------------------------------------------
  $("register").addEventListener("click", function () {
    var email = $("email").value.trim();
    if (!email) { say("Enter your email first.", "err"); return; }
    var btn = this; btn.disabled = true; say("Creating your account…", "info");

    api("/register", { method: "POST", body: { email: email } }).then(function (res) {
      btn.disabled = false;
      if (!res.ok) {
        var detail = res.body && res.body.details && res.body.details.email;
        say(detail ? "That email " + detail[0] + "." : "Could not register that email.", "err");
        return;
      }
      key = res.body.api_key; save(key);
      $("newkeyvalue").textContent = key;
      show("newkey");
      say("Account created — $" + (res.body.credit_granted_usd || 0).toFixed(2) + " of free credit added.", "ok");
    });
  });

  // ---- sign in ------------------------------------------------------------
  $("signin").addEventListener("click", function () {
    var v = $("key").value.trim();
    if (!v) { say("Paste your API key first.", "err"); return; }
    key = v; say("Checking…", "info");
    api("/billing/balance").then(function (res) {
      if (!res.ok) { key = null; say("That key was not accepted.", "err"); return; }
      save(key); say(""); refresh();
    });
  });

  $("copykey").addEventListener("click", function () {
    var btn = this;
    navigator.clipboard.writeText($("newkeyvalue").textContent).then(function () {
      btn.textContent = "Copied";
      setTimeout(function () { btn.textContent = "Copy key"; }, 1600);
    }, function () { say("Copy failed — select the key and copy it manually.", "err"); });
  });

  $("downloadkey").addEventListener("click", function () {
    var text = "CSuiteFinder API key\n" + $("newkeyvalue").textContent + "\n\n" +
               "Send it as: Authorization: Bearer <key>\n";
    var url = URL.createObjectURL(new Blob([text], { type: "text/plain" }));
    var a = document.createElement("a");
    a.href = url; a.download = "csuitefinder-api-key.txt";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  $("gotkey").addEventListener("click", function () { say(""); refresh(); });
  $("signout").addEventListener("click", function () { signOut("Signed out."); });

  // ---- keys ---------------------------------------------------------------
  function loadKeys() {
    api("/keys").then(function (res) {
      var body = $("keys");
      if (!res.ok) { body.innerHTML = '<tr><td colspan="4" class="muted">Could not load keys.</td></tr>'; return; }
      body.innerHTML = (res.body.keys || []).map(function (k) {
        var used = k.last_used_at ? new Date(k.last_used_at).toLocaleDateString() : "never";
        var state = k.revoked
          ? '<span class="muted">revoked</span>'
          : (k.current
              ? '<span class="muted">in use here</span>'
              : '<button class="ghost revoke" data-id="' + k.id + '">Revoke</button>');
        return "<tr><td><code>" + k.prefix + "…</code></td>" +
               "<td>" + (k.label || "") + "</td>" +
               '<td class="muted">' + used + "</td>" +
               '<td class="num">' + state + "</td></tr>";
      }).join("") || '<tr><td colspan="4" class="muted">No keys.</td></tr>';

      body.querySelectorAll(".revoke").forEach(function (b) {
        b.addEventListener("click", function () {
          if (!window.confirm("Revoke this key? Anything using it stops working immediately.")) return;
          b.disabled = true;
          api("/keys/" + b.getAttribute("data-id"), { method: "DELETE" }).then(function (r) {
            say(r.ok ? "Key revoked." : "Could not revoke that key.", r.ok ? "ok" : "err");
            loadKeys();
          });
        });
      });
    });
  }

  $("newkeybtn").addEventListener("click", function () {
    var btn = this; btn.disabled = true;
    api("/keys", { method: "POST", body: {} }).then(function (res) {
      btn.disabled = false;
      if (!res.ok) { say("Could not create a key.", "err"); return; }
      // Show it on the same one-time screen the first key uses, so the "save
      // this now" warning is never skipped for a second key.
      $("newkeyvalue").textContent = res.body.api_key;
      show("newkey");
      say("New key created. The one you are signed in with still works.", "ok");
    });
  });

  // ---- buy ----------------------------------------------------------------
  document.querySelectorAll(".bundle").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var usd = Number(btn.getAttribute("data-usd"));
      var back = window.location.origin + window.location.pathname;
      btn.disabled = true;
      say("Setting up your payment…", "info");

      api("/billing/topup", { method: "POST", body: {
        amount_usd: usd, return_url: back, cancel_url: back + "?cancelled=1"
      }}).then(function (res) {
        btn.disabled = false;
        if (res.ok && res.body.approve_url) {
          say("Redirecting you to PayPal…", "info");
          window.location.href = res.body.approve_url;
          return;
        }
        if (res.body && res.body.error === "paypal_not_configured") {
          say("Payments are not switched on yet. Please try again later.", "err");
        } else if (res.body && res.body.error === "below_minimum_purchase") {
          say("Purchases start at $" + commas(res.body.minimum_usd) + ".", "err");
        } else {
          say("Could not start that payment. Nothing was charged.", "err");
        }
      });
    });
  });

  // ---- returning from PayPal ---------------------------------------------
  // PayPal sends the order id back as ?token=… (its name, not ours) on the
  // return URL. Capture it, then clean the query so a refresh cannot re-post.
  function handleReturn() {
    var params = new URLSearchParams(window.location.search);
    var order = params.get("token");
    var cancelled = params.get("cancelled");

    function clean() {
      window.history.replaceState({}, "", window.location.pathname);
    }

    if (cancelled) { clean(); say("Payment cancelled — nothing was charged.", "info"); return false; }
    if (!order) return false;

    say("Confirming your payment…", "info");
    api("/billing/capture", { method: "POST", body: { paypal_order_id: order } })
      .then(function (res) {
        clean();
        if (res.ok && res.body.status === "credited") {
          say("Payment complete — $" + (res.body.credited_usd || 0).toFixed(2) + " of credit added.", "ok");
        } else {
          say("We could not confirm that payment yet. If you approved it, your credit will " +
              "appear shortly — PayPal notifies us separately.", "err");
        }
        refresh();
      });
    return true;
  }

  // ---- boot ---------------------------------------------------------------
  key = load();
  var returning = handleReturn();
  if (key) { if (!returning) refresh(); }
  else { show("signedout"); }
})();
</script>
</body>
</html>
