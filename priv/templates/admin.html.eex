<%= CsuiteFinderWeb.Layout.head(
      title: "CSuiteFinder — admin",
      robots: "noindex, nofollow",
      refresh: "60",
      nav: false,
      css: CsuiteFinderWeb.Layout.page_css(:admin),
      wrap_class: "wrap-wide"
    ) %>

<header>
  <div>
    <div class="title">CSuiteFinder <span>admin</span></div>
    <div class="meta">
      Last <%= @days %> days · generated <%= Calendar.strftime(@generated_at, "%Y-%m-%d %H:%M UTC") %> · refreshes every 60s
    </div>
  </div>
  <div class="windows">
    <%= for w <- @windows do %>
      <a class="<%= if w == @days, do: "on" %>" href="<%= CsuiteFinderWeb.AdminController.link_to(@base_path, @token, w) %>"><%= w %>d</a>
    <% end %>
  </div>
</header>

<div class="grid">
  <div class="card">
    <div class="label">Requests</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@headline.requests) %></div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.pct(@headline.found_rate) %> answered</div>
  </div>
  <div class="card">
    <div class="label">Cache hit rate</div>
    <div class="value <%= if @headline.cache_hit_rate >= 0.5, do: "good", else: "flat" %>">
      <%= CsuiteFinderWeb.AdminController.pct(@headline.cache_hit_rate) %>
    </div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.num(@headline.cache_hits) %> served free</div>
  </div>
  <div class="card">
    <div class="label">Revenue</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.usd(@headline.revenue_usd) %></div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.num(@headline.requests) %> requests</div>
  </div>
  <div class="card">
    <div class="label">Provider cost</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.usd(@headline.provider_cost_usd) %></div>
    <div class="sub">paid to treg</div>
  </div>
  <div class="card">
    <div class="label">Response time</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.ms(@headline.avg_ms) %></div>
    <div class="sub">p95 <%= CsuiteFinderWeb.AdminController.ms(@headline.p95_ms) %></div>
  </div>
  <div class="card">
    <div class="label">Gross margin</div>
    <div class="value <%= CsuiteFinderWeb.AdminController.tone(@headline.margin_usd) %>">
      <%= CsuiteFinderWeb.AdminController.usd(@headline.margin_usd) %>
    </div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.pct(@headline.margin_pct) %> of revenue</div>
  </div>
</div>

<h2>Find economics</h2>

<div class="panel">
  <h3>Every email found sells for <%= CsuiteFinderWeb.AdminController.micro_usd(@find_price_micro) %></h3>
  <p class="hint">
    A cached find costs us nothing. A fresh one falls through to a paid provider
    and can cost more than it earns — so the mix, not the average, is what
    decides whether finds make money.
  </p>

  <div class="split">
    <div class="seg win">
      <div class="n"><%= CsuiteFinderWeb.AdminController.num(@find_economics.cached.calls) %></div>
      <div class="k">cached finds · <%= CsuiteFinderWeb.AdminController.micro_usd(@find_economics.cached.margin_micro) %> each</div>
    </div>
    <div class="seg <%= if @find_economics.fresh.margin_micro < 0, do: "lose", else: "win" %>">
      <div class="n"><%= CsuiteFinderWeb.AdminController.num(@find_economics.fresh.calls) %></div>
      <div class="k">fresh finds · <%= CsuiteFinderWeb.AdminController.micro_usd(@find_economics.fresh.margin_micro) %> each</div>
    </div>
    <div class="seg">
      <div class="n <%= CsuiteFinderWeb.AdminController.tone(@find_economics.margin_per_find_micro) %>">
        <%= CsuiteFinderWeb.AdminController.micro_usd(@find_economics.margin_per_find_micro) %>
      </div>
      <div class="k">blended margin per find</div>
    </div>
  </div>

  <%= if @find_economics.breakeven_cache_rate do %>
  <div class="gauge">
    <div class="gauge-track">
      <div class="gauge-fill <%= if @find_economics.cache_hit_rate < @find_economics.breakeven_cache_rate, do: "short" %>"
           style="width: <%= Float.round(@find_economics.cache_hit_rate * 100, 1) %>%"></div>
      <div class="gauge-mark" style="left: <%= Float.round(@find_economics.breakeven_cache_rate * 100, 1) %>%"
           title="break-even"></div>
    </div>
    <div class="gauge-legend">
      <span>cache hit rate <strong><%= CsuiteFinderWeb.AdminController.pct(@find_economics.cache_hit_rate) %></strong></span>
      <span>break-even <strong><%= CsuiteFinderWeb.AdminController.pct(@find_economics.breakeven_cache_rate) %></strong></span>
    </div>
  </div>
  <% end %>
</div>

<h2>Response time</h2>

<div class="panel">
  <h3>What callers wait</h3>
  <p class="hint">
    End-to-end, from request to response — not just the upstream's share. Cached and
    fresh answers are separated because averaging them hides the thing worth knowing:
    a cached answer never leaves the building, so the blend moves with the hit rate
    rather than with anything about our own speed.
  </p>
  <div class="split">
    <div class="seg win">
      <div class="n"><%= CsuiteFinderWeb.AdminController.ms(@latency.cached_ms) %></div>
      <div class="k">cached · <%= CsuiteFinderWeb.AdminController.num(@latency.cached_calls) %> calls</div>
    </div>
    <div class="seg">
      <div class="n"><%= CsuiteFinderWeb.AdminController.ms(@latency.fresh_ms) %></div>
      <div class="k">fresh (upstream) · <%= CsuiteFinderWeb.AdminController.num(@latency.fresh_calls) %> calls</div>
    </div>
    <div class="seg">
      <div class="n"><%= CsuiteFinderWeb.AdminController.ms(@headline.p95_ms) %></div>
      <div class="k">p95 across everything</div>
    </div>
  </div>
</div>

<h2>Daily volume</h2>

<div class="panel">
  <%= if @chart.max > 0 do %>
    <!-- The series, and nothing about how to draw it. The script below turns
         this into a chart; the server has no opinion about pixels. -->
    <script type="application/json" id="volume-series"><%= CsuiteFinderWeb.AdminController.series_json(@chart) %></script>
    <div class="chart" id="volume">
      <div class="chart-fallback" id="volume-fallback">Loading the chart…</div>
      <div class="chart-tip" id="volume-tip" hidden></div>
    </div>
    <div class="chart-axis">
      <span><%= @chart.first %></span>
      <span>peak <%= CsuiteFinderWeb.AdminController.num(@chart.max) %>/day · shaded = cached</span>
      <span><%= @chart.last %></span>
    </div>
  <% else %>
    <div class="empty">No requests in this window yet.</div>
  <% end %>
</div>

<h2>By endpoint</h2>

<div class="panel">
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Endpoint</th><th></th>
          <th class="num">Calls</th><th class="num">Answered</th><th class="num">Cached</th>
          <th class="num">Avg</th><th class="num">p95</th>
          <th class="num">Cost</th><th class="num">Revenue</th>
        </tr>
      </thead>
      <tbody>
        <%= for row <- @by_endpoint do %>
        <tr>
          <td><code><%= CsuiteFinderWeb.AdminController.esc(row.endpoint) %></code></td>
          <td><span class="tag <%= unless row.metered, do: "free" %>"><%= if row.metered, do: "$" <> :erlang.float_to_binary(CsuiteFinder.Billing.Pricing.price_usd(row.endpoint), [:compact, decimals: 4]), else: "included" %></span></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.num(row.calls) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.pct(row.found_rate) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.pct(row.cache_hit_rate) %></td>
          <td class="num" title="cached <%= CsuiteFinderWeb.AdminController.ms(row.avg_cached_ms) %> · fresh <%= CsuiteFinderWeb.AdminController.ms(row.avg_fresh_ms) %>"><%= CsuiteFinderWeb.AdminController.ms(row.avg_ms) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.ms(row.p95_ms) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.usd(row.provider_cost_usd) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.usd(row.revenue_usd) %></td>
        </tr>
        <% end %>
        <%= if @by_endpoint == [] do %>
        <tr><td colspan="9" class="empty">No traffic in this window.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<h2>Customers</h2>

<div class="grid">
  <div class="card">
    <div class="label">Accounts</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@accounts.total) %></div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.num(@accounts.active) %> active this window</div>
  </div>
  <div class="card">
    <div class="label">Paying</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@accounts.paying) %></div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.num(@accounts.on_trial) %> still on trial</div>
  </div>
  <div class="card">
    <div class="label">Purchases</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.usd(@payments.amount_usd) %></div>
    <div class="sub"><%= CsuiteFinderWeb.AdminController.num(@payments.count) %> captured</div>
  </div>
  <div class="card">
    <div class="label">Deferred revenue</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.usd(@accounts.deferred_revenue_usd) %></div>
    <div class="sub">credit sold, not yet spent</div>
  </div>
</div>

<h2>Email corpus</h2>

<div class="grid">
  <div class="card">
    <div class="label">Total emails held</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@corpus.total) %></div>
    <div class="sub">distinct addresses</div>
  </div>
  <div class="card">
    <div class="label">Found</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@corpus.found) %></div>
    <div class="sub">resolved from a name</div>
  </div>
  <div class="card">
    <div class="label">Received</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@corpus.received) %></div>
    <div class="sub">from domain sweeps</div>
  </div>
  <div class="card">
    <div class="label">In both</div>
    <div class="value"><%= CsuiteFinderWeb.AdminController.num(@corpus.overlap) %></div>
    <div class="sub">counted once, not twice</div>
  </div>
</div>

<h2>Cache</h2>

<div class="panel">
  <h3><%= CsuiteFinderWeb.AdminController.num(@cache.patterns_held) %> company patterns held</h3>
  <p class="hint">
    Each one resolves every future employee of that company for free. This table
    is the asset the margin above is built on.
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Table</th><th class="num">Rows</th><th class="num">Stale</th></tr></thead>
      <tbody>
        <%= for row <- @cache.tables do %>
        <tr>
          <td><code><%= CsuiteFinderWeb.AdminController.esc(row.table) %></code></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.num(row.rows) %></td>
          <td class="num"><%= if is_nil(row.stale), do: "—", else: CsuiteFinderWeb.AdminController.num(row.stale) %></td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="hint" style="margin: 14px 0 0">
    Stale rows are answers we still hold but could not re-confirm on the last
    refresh. They are served with <code>stale: true</code> rather than dropped.
  </p>
</div>

<h2>Providers</h2>

<div class="panel">
  <p class="hint">
    Ranked by expected cost per success — sticker price divided by the
    difficulty-weighted hit rate. This is the order the waterfall tries them in.
  </p>
  <%= for {capability, report} <- @providers do %>
  <div class="table-scroll" style="margin-bottom: 18px">
    <table>
      <thead>
        <tr>
          <th><%= CsuiteFinderWeb.AdminController.esc(capability) %></th>
          <th class="num">Hit rate</th><th class="num">Hits</th>
          <th class="num">Cost/hit</th><th class="num">Expected/success</th>
        </tr>
      </thead>
      <tbody>
        <%= for p <- report.providers do %>
        <tr>
          <td><code><%= CsuiteFinderWeb.AdminController.esc(p.provider) %></code><%= if p.cost_is_estimated do %> <span class="tag">est</span><% end %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.pct(p.weighted_hit_rate) %></td>
          <td class="num"><%= p.hits %>/<%= p.attempts %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.micro_usd(p.cost_micro_per_hit) %></td>
          <td class="num"><%= CsuiteFinderWeb.AdminController.micro_usd(p.expected_cost_micro_per_success) %></td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
  <%= if @providers == %{} do %>
    <div class="empty">No provider calls recorded yet.</div>
  <% end %>
</div>

<footer>
  <!-- This page deliberately carries no nav — it is an operator's, not a
       customer's. That left no way back to the site at all, which reads as a
       broken page rather than a focused one. -->
  <a href="/">Home</a> ·
  <a href="/teams">Sales</a> ·
  <a href="/developers">Developers</a> ·
  <a href="/account">Account</a> ·
  <a href="<%= CsuiteFinderWeb.AdminController.esc(@base_path) %>/metrics.json<%= if @token, do: "?token=" <> CsuiteFinderWeb.AdminController.esc(URI.encode_www_form(@token)) %>">metrics.json</a>
  · $<%= :erlang.float_to_binary(CsuiteFinder.Billing.Pricing.price_usd("email.find"), [:compact, decimals: 4]) %> an email, $<%= :erlang.float_to_binary(CsuiteFinder.Billing.Pricing.price_usd("phone.find"), [:compact, decimals: 4]) %> a phone
</footer>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
// The daily-volume chart. D3 rather than geometry computed in the controller:
// the scales, the axis ticks and the hit-testing are the library's job, and the
// server sends a series with no opinion about pixels. Pinned to an exact
// version — a dashboard that changes shape because a CDN moved on is worse than
// one that does not change at all.
(function () {
  "use strict";

  var host = document.getElementById("volume");
  var fallback = document.getElementById("volume-fallback");
  var tip = document.getElementById("volume-tip");
  if (!host) return;

  if (typeof d3 === "undefined") {
    fallback.textContent = "The chart library did not load.";
    return;
  }

  var series;
  try {
    series = JSON.parse(document.getElementById("volume-series").textContent);
  } catch (e) {
    fallback.textContent = "Could not read the chart data.";
    return;
  }
  if (!series.length) { fallback.textContent = "Nothing to plot."; return; }

  fallback.hidden = true;

  var svg = d3.select(host).append("svg").attr("class", "chart-svg");
  var plot = svg.append("g");
  var axis = svg.append("g").attr("class", "chart-ticks");
  var margin = { top: 6, right: 0, bottom: 0, left: 34 };

  function commas(n) { return (n || 0).toLocaleString("en-US"); }

  function draw() {
    var width = host.clientWidth || 1;
    var height = host.clientHeight || 1;
    var inner = { w: Math.max(width - margin.left - margin.right, 1),
                  h: Math.max(height - margin.top - margin.bottom, 1) };

    svg.attr("width", width).attr("height", height);
    plot.attr("transform", "translate(" + margin.left + "," + margin.top + ")");
    axis.attr("transform", "translate(" + margin.left + "," + margin.top + ")");

    var x = d3.scaleBand()
      .domain(series.map(function (d, i) { return i; }))
      .range([0, inner.w])
      .padding(0.28);

    var peak = d3.max(series, function (d) { return d.requests; }) || 1;
    var y = d3.scaleLinear().domain([0, peak]).nice().range([inner.h, 0]);

    // Two or three gridlines. More would be a chart about its own axis.
    var ticks = y.ticks(3);
    var lines = axis.selectAll("g.tick").data(ticks);
    var entered = lines.enter().append("g").attr("class", "tick");
    entered.append("line");
    entered.append("text");

    var all = entered.merge(lines);
    all.attr("transform", function (d) { return "translate(0," + y(d) + ")"; });
    all.select("line").attr("x1", 0).attr("x2", inner.w);
    all.select("text").attr("x", -8).attr("dy", "0.32em").text(function (d) { return commas(d); });
    lines.exit().remove();

    // Stacked: the cached share at the base, the rest above it. Reading the
    // split off two segments beats reading it off an overlay.
    var groups = plot.selectAll("g.bar").data(series);
    var g = groups.enter().append("g").attr("class", "bar");
    g.append("rect").attr("class", "cached");
    g.append("rect").attr("class", "fresh");

    var bars = g.merge(groups);
    bars.attr("transform", function (d, i) { return "translate(" + x(i) + ",0)"; });

    bars.select("rect.cached")
      .attr("width", x.bandwidth())
      .attr("y", function (d) { return y(Math.min(d.cached, d.requests)); })
      .attr("height", function (d) { return inner.h - y(Math.min(d.cached, d.requests)); });

    bars.select("rect.fresh")
      .attr("width", x.bandwidth())
      .attr("y", function (d) { return y(d.requests); })
      .attr("height", function (d) {
        return Math.max(y(Math.min(d.cached, d.requests)) - y(d.requests), 0);
      });

    // One transparent rect per column, so a day with barely any traffic is as
    // easy to hover as a day with a lot.
    bars.selectAll("rect.hit").data(function (d) { return [d]; }).enter()
      .append("rect")
      .attr("class", "hit")
      .attr("x", -x.step() * x.padding() / 2)
      .attr("y", 0)
      .attr("width", x.step())
      .attr("height", inner.h);

    bars.selectAll("rect.hit")
      .attr("width", x.step())
      .attr("height", inner.h)
      .on("pointerenter", function (event, d) {
        tip.hidden = false;
        tip.textContent = d.label + " · " + commas(d.requests) + " requests · " +
                          commas(d.cached) + " cached";
        var box = host.getBoundingClientRect();
        tip.style.left = Math.min(event.clientX - box.left + 12,
                                  box.width - tip.offsetWidth - 8) + "px";
        tip.style.top = Math.max(event.clientY - box.top - 34, 4) + "px";
      })
      .on("pointerleave", function () { tip.hidden = true; });

    groups.exit().remove();
  }

  new ResizeObserver(draw).observe(host);
  draw();
})();
</script>
</body>
</html>
