# Copy to /etc/csuite-finder.env, fill in, then:
#   sudo chown root:root /etc/csuite-finder.env && sudo chmod 600 /etc/csuite-finder.env
#
# systemd reads this file directly: no quotes, no `export`, no shell expansion.

# --- required -------------------------------------------------------------
MIX_ENV=prod
PHX_SERVER=true
PORT=4000

# Must match the domain nginx serves, or generated URLs point at example.com.
PHX_HOST=api.example.com

# A FULL connection URL — not a host:port pair. Percent-encode a password
# containing @ : / or ?, since a raw @ splits the URL at the wrong place.
#   ecto://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=ecto://csuite:CHANGEME@localhost/csuite_finder_prod

# ...OR, to connect with NO password over the Unix socket (Postgres peer auth),
# comment out DATABASE_URL above and uncomment these three. This cannot be
# written as a URL: Ecto requires a host and rejects a hostless one even with
# ?socket_dir=, so the socket form gets its own variables.
# DATABASE_SOCKET_DIR=/var/run/postgresql
# DATABASE_NAME=csuite_finder_prod
# DATABASE_USER=csuite

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGEME

# --- treg (the data provider) ---------------------------------------------
# From `treg login`. TREG_ORG is only needed for an identity token; a per-org
# agent token (treg org agent-new) has the org baked in and is the better
# choice for a server.
TREG_TOKEN=CHANGEME
TREG_ORG=

# --- admin dashboard ------------------------------------------------------
# Unset means /admin returns 503. Generate with: openssl rand -hex 32
ADMIN_TOKEN=CHANGEME

# --- PayPal ---------------------------------------------------------------
# Omit entirely to run without payments; /health reports paypal_configured.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- email (optional, but needed for API-key recovery) --------------------
# Without SMTP_HOST a customer who loses their key cannot get a replacement —
# we only store a hash, so there is nothing to resend. Any SMTP provider works
# (Resend, Postmark, SES, Mailgun, Fastmail...).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@csuitefinder.com
# MAIL_FROM_NAME=CSuiteFinder

# --- optional -------------------------------------------------------------
POOL_SIZE=10
# Only for platforms that route to the container address (Fly, k8s). Behind
# nginx leave this unset so the app binds loopback and cannot be reached
# directly on port 4000.
# BIND_ALL=true
